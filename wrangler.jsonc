{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tranquilprize-preview",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "env": {
    "production": {
      "name": "tranquilprize",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "tranquilprize.com", "custom_domain": true },
        { "pattern": "www.tranquilprize.com", "custom_domain": true },
      ],
    },
  },
}
