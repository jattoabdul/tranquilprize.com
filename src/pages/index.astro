---
import Layout from '../layouts/Layout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Mic from '../components/Mic.astro';
import Chevrons from '../components/Chevrons.astro';
import SponsorWall from '../components/SponsorWall.astro';
import { event, programme, people } from '../data/event';

const meridiem = (time: string) => {
  const hour = Number(time.split(':')[0]);
  return hour >= 8 && hour < 12 ? 'a.m.' : 'p.m.';
};
const highlightStarts = ['8:30', '10:30', '10:40', '1:30', '3:15', '4:25'];
const highlights = highlightStarts.map((start) =>
  programme.find((item) => item.start === start)!,
);
const initials = (name: string) =>
  name
    .replace(/^((Dr|Mrs|Mr|Mal|Hon|Engr)\.?\s+)+/, '')
    .split(/\s+/)
    .filter((part) => /^[A-Z]/.test(part))
    .slice(0, 2)
    .map((part) => part[0])
    .join('');
const onStage = [
  people.convener,
  ...people.judges,
  ...people.guests,
  ...people.performers,
];

const rounds = [
  {
    count: '50',
    name: 'Round One',
    title: 'The Power of Persuasion',
    detail: 'One minute to make a case for an idea. Fifteen advance.',
  },
  {
    count: '15',
    name: 'Semifinal',
    title: 'The Power of Solutions',
    detail:
      'Three minutes on a practical solution to a school or community challenge, then feedback from the panel. Five advance.',
  },
  {
    count: '5',
    name: 'Final',
    title: '“Dear Mr Governor”',
    detail:
      'A two-minute appeal for positive change, then questions from the judges.',
  },
  {
    count: '3',
    name: 'Awards',
    title: 'The winning voices',
    detail: 'A winner, a first runner-up and a second runner-up.',
  },
];

const faqs = [
  [
    'Is it free to attend?',
    'Yes. Audience attendance is free, and no approval is required. RSVP through Luma so we can welcome you. An audience RSVP is separate from a contestant application.',
  ],
  [
    'What time should I arrive?',
    `Arrivals and the purple carpet begin at ${event.arrival} WAT and the programme starts at ${event.programmeStart} WAT. The opening ceremony is at 10:30 a.m. and the event closes at ${event.close} WAT.`,
  ],
  [
    'Who can compete?',
    'Secondary-school students in JS1–SS3, inclusive, selected through an online audition. About 50 contestants take part in all three rounds on the day.',
  ],
  [
    'Can I leave and come back?',
    'Yes. Breaks and lunch are marked on the programme of events, which is the best time to move in and out of the hall.',
  ],
  [
    'Will the event be filmed?',
    'Photography and filming are planned, including a YouTube feature. The organising team coordinates participant and guardian permissions. Ask the host about the arrangements before attending.',
  ],
];
---

<Layout
  title="TPSP 2026 | Tranquil’s Public Speaking Prize"
  description={`Secondary-school students from across Kwara State compete for the winning voice. Thursday 19 November 2026, Main Hall, Ilorin Innovation Hub. Arrivals and purple carpet ${event.arrival} WAT. Free entry with RSVP.`}
>
  <section class="hero">
    <div class="hero-light" aria-hidden="true"></div>
    <Chevrons class="hero-chevrons" />
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <h1>
          <span class="h1-small">Tranquil’s</span>
          Public Speaking
          <span class="h1-gold">Prize 2026</span>
        </h1>
        <p class="hero-sub">
          A public speaking contest for secondary-school students in Kwara
          State. Theme: <strong>{event.theme}.</strong>
        </p>
        <ul class="pills" aria-label="Our values">
          <li class="pill-magenta">Express</li>
          <li class="pill-yellow">Develop</li>
          <li class="pill-lilac">Lead</li>
        </ul>
        <div class="hero-actions">
          <a class="button yellow" href="/programme/">
            See the programme <span aria-hidden="true">→</span>
          </a>
          <ExternalLink href={event.rsvp} class="button outline">
            RSVP to attend
          </ExternalLink>
        </div>
      </div>
      <div class="hero-stage">
        <Mic class="hero-mic" />
        <dl class="ticket">
          <div>
            <dt>Date</dt>
            <dd>
              <strong>Thurs. 19th November</strong>
              2026
            </dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>
              <strong>{event.arrival} arrivals</strong>
              Purple carpet. Programme from {event.programmeStart} WAT
            </dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>
              <strong>Main Hall</strong>
              Ilorin Innovation Hub, Ilorin
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="about" class="statement section wrap">
    <h2>
      Big ideas.
      <br />
      Young voices.
      <br />
      <span class="grad-text">A shared future.</span>
    </h2>
    <div class="statement-copy">
      <p class="lead">
        A good idea can begin in a classroom. A confident voice can carry it
        further.
      </p>
      <p>
        Tranquil’s Public Speaking Prize brings secondary-school students from
        across Kwara State together to say what matters to them, listen to one
        another and compete for the winning voice. Convened by{' '}
        <strong>{event.organiser}</strong>.
      </p>
      <ul class="values">
        <li>
          <span class="value-tag pill-magenta">Express</span>
          Share an idea that matters, in your own words.
        </li>
        <li>
          <span class="value-tag pill-yellow">Develop</span>
          Build confidence and communication on a real stage.
        </li>
        <li>
          <span class="value-tag pill-lilac">Lead</span>
          Speak up for change in your school and community.
        </li>
      </ul>
    </div>
  </section>

  <section id="rounds" class="rounds section">
    <div class="wrap">
      <div class="section-head">
        <h2>Three rounds. One stage. One day.</h2>
        <p>
          Contestants were selected through an online audition. On 19 November
          they climb, round by round, toward the winning voice.
        </p>
      </div>
      <ol class="risers">
        {rounds.map((round, i) => (
          <li style={`--step:${i}`}>
            <span class="riser-count">{round.count}</span>
            <div class="riser-body">
              <h3>
                <span class="riser-name">{round.name}</span>
                {round.title}
              </h3>
              <p>{round.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="prize wrap" aria-labelledby="prize-heading">
    <div class="prize-card">
      <h2 id="prize-heading">Who will take home the grand prize?</h2>
      <p class="prize-amount">₦500,000</p>
      <p>Come and cheer on the next generation of speakers.</p>
    </div>
  </section>

  <section id="programme" class="glance section wrap">
    <div class="section-head">
      <h2>Your day at a glance.</h2>
      <p>
        All times WAT. The full running order lists every break and
        announcement.
      </p>
    </div>
    <ol class="glance-list">
      {highlights.map((item) => (
        <li class={item.kind ? `is-${item.kind}` : undefined}>
          <p class="glance-time">
            {item.start} <span>{meridiem(item.start)}</span>
          </p>
          <p class="glance-title">{item.title}</p>
        </li>
      ))}
    </ol>
    <div class="glance-actions">
      <a class="button purple" href="/programme/">
        Full programme of events <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href="/tpsp-2026-programme.pdf">
        Download the printable programme <span aria-hidden="true">↓</span>
        <span class="sr-only"> (PDF)</span>
      </a>
    </div>
  </section>

  <section id="people" class="people-home section">
    <div class="wrap">
      <div class="section-head">
        <h2>On stage with us.</h2>
        <p>
          The convener, judges, special guests and guest performer for TPSP
          2026.
        </p>
      </div>
      <ul class="people-cards">
        {onStage.map((person, i) => (
          <li style={`--tone:${i % 4}`}>
            <span class="avatar" aria-hidden="true">
              {initials(person.name)}
            </span>
            <span class="person-name">{person.name}</span>
            <span class="person-role">{person.role}</span>
            {person.title && <span class="person-title">{person.title}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="sponsors" class="sponsors section wrap">
    <div class="section-head">
      <h2>With thanks to our sponsors and partners.</h2>
      <p>TPSP 2026 is made possible by the people and organisations below.</p>
    </div>
    <SponsorWall />
  </section>

  <section id="venue" class="venue">
    <Chevrons class="venue-chevrons" />
    <div class="venue-inner wrap section">
      <h2>
        See you in
        <br />
        the Main Hall.
      </h2>
      <dl class="venue-details">
        <div>
          <dt>Where</dt>
          <dd>
            {event.venue}
            <br />
            9a Ahmadu Bello Way, Ilorin, Kwara State
          </dd>
        </div>
        <div>
          <dt>When</dt>
          <dd>
            {event.date}
            <br />
            {event.arrival} arrivals and purple carpet
            <br />
            {event.programmeStart} programme starts, {event.close} close
          </dd>
        </div>
        <div>
          <dt>Entry</dt>
          <dd>Free. RSVP on Luma. No approval required.</dd>
        </div>
      </dl>
      <ExternalLink href={event.rsvp} class="button yellow">
        RSVP to attend
      </ExternalLink>
    </div>
  </section>

  <section id="questions" class="faq section wrap">
    <div>
      <h2>Good to know.</h2>
      <p>
        Have a question? Email{' '}
        <a href={`mailto:${event.email}`}>{event.email}</a> or use “Contact the
        Host” on the{' '}
        <a href={event.rsvp} target="_blank" rel="noopener noreferrer">
          Luma event page<span class="sr-only"> (opens in a new tab)</span>
        </a>
        .
      </p>
      <a class="text-link" href="/enter/">
        Contestant guide <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>
            {question}
            <span aria-hidden="true">＋</span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
