---
import Layout from '../layouts/Layout.astro';
import Bloom from '../components/Bloom.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { Image } from 'astro:assets';
import cover from '../assets/tpsp-cover-concept.png';
import { event } from '../data/event';
const faqs = [
  [
    'Who can enter?',
    'Secondary-school students in JS1–SS3, inclusive. A parent or legal guardian must submit the audition. Selected contestants attend the physical competition in Ilorin.',
  ],
  [
    'Is it free to attend?',
    'Yes. Audience attendance is free, and no approval is required. RSVP through Luma to attend. An audience RSVP is separate from a contestant application.',
  ],
  [
    'Can I compete online?',
    'The audition submission is the only remote stage. Approximately 50 selected contestants will attend all three physical rounds in Ilorin on 19 November 2026.',
  ],
  [
    'Do I need to be an experienced speaker?',
    'You can start with an idea that matters to you. The audition asks you to speak naturally, without reading a script, for a maximum of 60 seconds. Read the contestant guide before recording.',
  ],
  [
    'When does the event start?',
    `Arrivals begin at ${event.arrival} WAT. The main programme starts promptly at ${event.programmeStart} WAT and the event closes at ${event.close} WAT.`,
  ],
  [
    'Will the event be filmed?',
    'Photography and filming are planned, including a YouTube feature. The organising team will coordinate participant and guardian permissions. Ask the host about the arrangements before attending.',
  ],
];
---

<Layout
  title="TPSP 2026 | Tranquil Public Speaking Prize"
  description="Your ideas deserve to be heard. A public speaking competition for JS1–SS3 students, 19 November 2026 in Ilorin. Enter the audition or RSVP to attend free."
>
  <section class="hero">
    <div class="hero-content wrap">
      <div class="hero-copy">
        <h1>
          Your ideas
          <br />
          deserve to
          <br />
          be heard.
        </h1>
        <p>
          Tranquil Public Speaking Prize 2026.
          <br />A stage for secondary-school students in JS1–SS3.
        </p>
        <div class="hero-actions">
          <a class="button cream" href="/enter/">
            Enter the competition <span aria-hidden="true">↗</span>
          </a>
          <ExternalLink href={event.rsvp} class="text-link light">
            RSVP to attend
          </ExternalLink>
        </div>
      </div>
      <Bloom />
    </div>
    <div class="event-strip wrap">
      <p>
        <span>Thursday</span>
        <strong>19 November 2026</strong>
      </p>
      <p>
        <span>Main Hall</span>
        <strong>Ilorin Innovation Hub</strong>
      </p>
      <p>
        <span>Arrivals from</span>
        <strong>{event.arrival} WAT</strong>
      </p>
    </div>
  </section>
  <section id="about" class="about section wrap">
    <h2>
      Big ideas.
      <br />
      Young voices.
      <br />
      <span class="purple-text">A shared future.</span>
    </h2>
    <div class="about-copy">
      <p class="lead">
        A good idea can begin in a classroom. A confident voice can carry it
        further.
      </p>
      <p>
        The Tranquil Public Speaking Prize brings secondary-school students
        together to express what matters to them, listen to one another and make
        their ideas heard.
      </p>
      <p>
        Under the theme <strong>“Voices for the Future,”</strong> TPSP
        celebrates confidence, communication and leadership. The competition is
        convened by <strong>Sakeenah Jatto.</strong>
      </p>
      <a class="text-link" href="/enter/">
        Find your place on the stage <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section id="journey" class="journey section">
    <div class="wrap">
      <h2>
        It starts with
        <br />
        one minute.
      </h2>
      <p class="journey-intro">
        An online audition. Then one day in Ilorin, with three rounds and a room
        ready to listen.
      </p>
      <ol class="journey-track">
        <li>
          <span class="journey-number">
            60<span>sec</span>
          </span>
          <h3>Online audition</h3>
          <p>Share the change you want to make in your school or community.</p>
          <a href="/enter/">
            Read the audition guide <span aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <span class="journey-number">
            <small>≈</small>50
          </span>
          <h3>First round</h3>
          <p>Selected contestants take the stage in Ilorin. Fifteen advance.</p>
        </li>
        <li>
          <span class="journey-number">15</span>
          <h3>Semifinal</h3>
          <p>
            The competition continues, with five speakers reaching the final.
          </p>
        </li>
        <li>
          <span class="journey-number">5</span>
          <h3>Final</h3>
          <p>Five finalists speak for the winner and two runner-up places.</p>
        </li>
      </ol>
      <div class="journey-end">
        <span class="top-three">3</span>
        <p>
          A winner. A first runner-up.
          <br />A second runner-up.
        </p>
        <p class="journey-note">
          All three physical rounds take place
          <br />
          on Thursday, 19 November 2026.
        </p>
      </div>
    </div>
  </section>
  <section id="attend" class="attend section wrap">
    <div class="attend-title">
      <h2>
        Be in the room
        <br />
        for what’s next.
      </h2>
      <p class="lead">
        Bring your encouragement.
        <br />
        They’ll bring their ideas.
      </p>
    </div>
    <div class="attend-details">
      <p>
        Join parents, guardians, teachers, students and supporters for live
        speeches, feedback from judges and the celebration of our top three
        speakers.
      </p>
      <dl class="event-details">
        <div>
          <dt>When</dt>
          <dd>
            {event.date}
            <br />
            {event.arrival} arrivals
            <br />
            {event.programmeStart} programme starts
            <br />
            {event.close} close
            <br />
            <span class="small">All times WAT</span>
          </dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>
            {event.venue}
            <br />
            {event.city}
          </dd>
        </div>
        <div>
          <dt>Admission</dt>
          <dd>
            Free. RSVP on Luma.
            <br />
            No approval required.
          </dd>
        </div>
      </dl>
      <ExternalLink href={event.rsvp} class="button purple">
        RSVP to attend
      </ExternalLink>
      <p class="small">
        For audience attendance. Contestants apply separately.
      </p>
    </div>
  </section>
  <section class="poster-section">
    <div class="poster-inner wrap">
      <Image
        src={cover}
        alt="TPSP 2026 event cover: Voices for the Future, 19 November 2026, Ilorin Innovation Hub."
        width={600}
        widths={[360, 600, 720, 900]}
        sizes="(max-width: 767px) 90vw, 44vw"
        format="webp"
        loading="lazy"
      />
      <div>
        <h2>
          One idea.
          <br />
          Your voice.
          <br />
          Start here.
        </h2>
        <p>
          You have 60 seconds to tell us about a change you’d like to see. A
          parent or guardian can help you take the first step.
        </p>
        <a href="/enter/" class="button cream">
          Prepare your audition <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section id="questions" class="faq section wrap">
    <div>
      <h2>
        A few things
        <br />
        to know.
      </h2>
      <p>
        Have a question? Email{' '}
        <a href={`mailto:${event.email}`}>{event.email}</a> or use “Contact the
        Host” on the{' '}
        <a href={event.rsvp} target="_blank" rel="noopener noreferrer">
          Luma event page<span class="sr-only"> (opens in a new tab)</span>
        </a>
        .
      </p>
    </div>
    <div class="faq-list">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>
            {question}
            <span aria-hidden="true">＋</span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
