---
interface Props {
  href: string;
  class?: string;
}
const { href, class: className = 'button' } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener noreferrer">
  <slot />
  <span aria-hidden="true">↗</span>
  <span class="sr-only"> (opens in a new tab)</span>
</a>
