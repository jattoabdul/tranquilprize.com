{
  "name": "tranquil-prize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && node scripts/check-build.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "deploy": "wrangler deploy --env production",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
